# TW Ventures — Environment Variables
#
# Copy to .env and fill in real values. Never commit .env.
#
# Two kinds of variable live here. The VITE_-prefixed ones are inlined into the
# browser bundle at build time, so they must be publishable values and must be
# present when you run `npm run build`. The commented ones are server-side
# secrets set on Supabase (`supabase secrets set NAME=value`) or on Vercel, and
# must never appear in .env.

# ── Supabase (required) ───────────────────────────────────────────────────────
# Project Settings → API. The build fails without these rather than shipping a
# bundle that can never authenticate.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ── Mapbox (optional) ─────────────────────────────────────────────────────────
# Needed by the deal-sourcing map and the portfolio project maps. Without it
# those maps do not render; the rest of the app is unaffected.
VITE_MAPBOX_TOKEN=pk.eyJ1...

# ── Web push (optional) ───────────────────────────────────────────────────────
# Public half of a VAPID keypair, read when a user enables push notifications.
# Generate a pair with `npx web-push generate-vapid-keys`.
VITE_VAPID_PUBLIC_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Server-side secrets below this line. Nothing here belongs in .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase runtime (set automatically in deployed functions) ────────────────
#   SUPABASE_URL=...
#   SUPABASE_ANON_KEY=...
#   SUPABASE_SERVICE_ROLE_KEY=...   # full database access — never client-side

# ── Stripe (subscriptions) ───────────────────────────────────────────────────
#   STRIPE_SECRET_KEY=sk_live_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   STRIPE_TIER1_PRICE_ID=price_...
#   STRIPE_TIER2_PRICE_ID=price_...
#   STRIPE_TIER3_PRICE_ID=price_...

# ── FRED / St. Louis Fed (rates dashboard) ───────────────────────────────────
# Policy rates, the Treasury curve, and consumer borrowing costs. Free key:
#   https://fredaccount.stlouisfed.org/apikeys
# Without it, fetch-rates answers 200 with an empty set and the panel says so.
#   FRED_API_KEY=...

# ── Mapbox (server-side token for get-mapbox-token) ──────────────────────────
#   MAPBOX_PUBLIC_TOKEN=pk.eyJ1...

# ── Anthropic (portfolio case-study drafting) ────────────────────────────────
# Used by generate-portfolio-story. Without it that function returns an error
# and the PM writes the case study by hand.
#   ANTHROPIC_API_KEY=sk-ant-...

# ── Lead sourcing ────────────────────────────────────────────────────────────
# Socrata raises the rate limit on municipal open-data endpoints; optional.
#   SOCRATA_APP_TOKEN=...
# Shared secret guarding manual invocation of the lead fetch job.
#   FETCH_TRIGGER_SECRET=generate-a-long-random-secret

# ── Email (Resend) ───────────────────────────────────────────────────────────
#   RESEND_API_KEY=re_...
#   RESEND_WEBHOOK_SECRET=whsec_...
#   NOTIFICATION_FROM_EMAIL=TW Ventures <notifications@your-verified-domain.example>
#   EMAIL_PREFERENCES_URL=https://your-deployed-domain.example/?module=account
#   EMAIL_UNSUBSCRIBE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/email-unsubscribe
# Required by commercial email compliance; use the sender's real postal address.
#   EMAIL_POSTAL_ADDRESS=123 Example Street, City, ST 00000

# ── Web push (private half) ──────────────────────────────────────────────────
#   VAPID_PUBLIC_KEY=
#   VAPID_PRIVATE_KEY=
#   VAPID_SUBJECT=mailto:notifications@your-verified-domain.example

# ── Notification dispatch ────────────────────────────────────────────────────
#   APP_URL=https://your-deployed-domain.example
#   SITE_URL=https://your-deployed-domain.example
#   NOTIFICATION_DISPATCH_SECRET=generate-a-long-random-secret
# Vercel environment variable, not a Supabase secret. Guards the cron proxy at
# api/dispatch-notifications; without it that endpoint answers 401 and the
# outbox is never drained.
#   CRON_SECRET=generate-a-long-random-secret
