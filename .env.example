# SomaTech — Environment Variables
# Copy to .env and fill in real values. Never commit .env to source control.

# ── Supabase (required) ───────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ── Stripe ────────────────────────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Supabase Edge Function secrets:
#   STRIPE_SECRET_KEY=sk_live_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   STRIPE_TIER1_PRICE_ID=price_...
#   STRIPE_TIER2_PRICE_ID=price_...
#   STRIPE_TIER3_PRICE_ID=price_...

# ── Anthropic (Edge Functions only) ──────────────────────────────────────────
#   ANTHROPIC_API_KEY=sk-ant-...

# ── Alpha Vantage (Edge Functions only) ───────────────────────────────────────
#   ALPHA_VANTAGE_API_KEY=...

# ── FRED / St. Louis Fed (Edge Functions only) ────────────────────────────────
# Powers the dashboard Rates panel: policy rates, the Treasury curve, and
# consumer borrowing costs. Free key, no usage tier:
#   https://fredaccount.stlouisfed.org/apikeys
# Without it, fetch-rates answers 200 with an empty set and the panel says so.
#   FRED_API_KEY=...

# ── Plaid (required for bank connection + Personal Finance auto-sync) ─────────
# The client ID is safe for the browser — used to initialize the Link widget.
VITE_PLAID_CLIENT_ID=your_plaid_client_id

# Supabase Edge Function secrets (never in .env):
#   PLAID_CLIENT_ID=...        # same value, needed server-side too
#   PLAID_SECRET=...           # sandbox / development / production secret key
#   PLAID_ENV=sandbox          # 'sandbox' | 'development' | 'production'

# ── Discord ───────────────────────────────────────────────────────────────────
VITE_DISCORD_CLIENT_ID=123456789012345678
# Supabase Edge Function secrets:
#   DISCORD_CLIENT_SECRET=...
#   DISCORD_BOT_TOKEN=Bot ...
#   DISCORD_GUILD_ID=...
#   DISCORD_ROLE_TIER1_ID=...
#   DISCORD_ROLE_TIER2_ID=...
#   DISCORD_ROLE_TIER3_ID=...

# ── Mapbox ────────────────────────────────────────────────────────────────────
VITE_MAPBOX_TOKEN=pk.eyJ1...

# ── App ───────────────────────────────────────────────────────────────────────
VITE_APP_ENV=development
VITE_DEBUG_MODE=false
VITE_ENABLE_MAPBOX=true
VITE_ENABLE_SUPABASE=true
VITE_API_BASE_URL=http://localhost:8081
# Supabase Edge Function secrets:
#   APP_URL=https://somatech.pro
#   SITE_URL=https://somatech.pro
#   NOTIFICATION_DISPATCH_SECRET=generate-a-long-random-secret
#   RESEND_API_KEY=re_...
#   NOTIFICATION_FROM_EMAIL=SomaTech <notifications@your-verified-domain.example>
#   EMAIL_PREFERENCES_URL=https://somatech.pro/?module=account
#   EMAIL_UNSUBSCRIBE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/email-unsubscribe
# Required by commercial email compliance; use the sender's real postal address.
#   EMAIL_POSTAL_ADDRESS=123 Example Street, City, ST 00000
